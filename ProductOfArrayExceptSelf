class Solution {
    /**
     *  Time: o(2n)==> o(n)
        space: o(1)
     */
    public int[] productExceptSelf(int[] nums) {
        int result[] = new int[nums.length];
        int rp = 1;
        result[0] = rp;

        //rp is nothing but the product till that index except current index.
        //this is to put left prefix running product till ith index
        for (int i = 1; i < nums.length; i++) {
            rp = rp*nums[i-1];
            result[i]=rp;

        }
        rp=1;
        //Muliply existing left running products with right running product
        for(int j=nums.length-2; j>=0; j--){
          rp = rp*nums[j+1];
            result[j]=rp*result[j];
        }
        return result;

    }
}